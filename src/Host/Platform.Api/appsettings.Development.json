    "Platform": "Host=localhost;Port=5433;Database=platform;Username=platform;Password=platform;Timeout=5"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

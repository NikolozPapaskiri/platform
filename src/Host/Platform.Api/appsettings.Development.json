{
  // LOCAL DEVELOPMENT ONLY: points at the throwaway PostgreSQL container from docker-compose.yml, as
  // the platform_app role (not the owner; see ADR 0003). These are not real credentials. Every other
  // environment supplies ConnectionStrings__Platform through environment variables or a secret store.
  "ConnectionStrings": {
    "Platform": "Host=localhost;Port=5433;Database=platform;Username=platform_app;Password=platform_app;Timeout=5"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
